{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batuta.space/schema/event.schema.json",
  "title": "Private local Batuta event v2",
  "description": "Owner-only JSONL observation. Raw events are never uploaded and never constitute delivery proof. The parser still reads v1 records during the compatibility window; new writers emit only this English v2 contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "v", "t", "type"],
  "properties": {
    "schema": { "const": "batuta.event.v2" },
    "v": { "const": 2 },
    "t": { "$ref": "#/$defs/count" },
    "timestamp": { "type": "number", "minimum": 0 },
    "type": { "enum": ["route", "route_error", "activation", "outcome"] },
    "turn_id": { "$ref": "#/$defs/correlation" },
    "turn": { "$ref": "#/$defs/correlation", "deprecated": true },
    "prompt_hash": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "prompt_len": { "$ref": "#/$defs/count" },
    "terms": { "$ref": "#/$defs/count" },
    "holdout": { "type": "boolean" },
    "holdout_declared": { "const": true },
    "mode": { "enum": ["hook", "mcp", "skill", "lab"] },
    "batuta_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "ms": { "type": "number", "minimum": 0 },
    "duration_ms": { "type": "number", "minimum": 0 },
    "suggestions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "version", "score"],
        "properties": {
          "skill": { "$ref": "#/$defs/skill" },
          "version": { "type": "string", "maxLength": 100 },
          "score": { "type": "number", "minimum": 0 }
        }
      }
    },
    "skill": { "$ref": "#/$defs/skill" },
    "version": { "type": "string", "maxLength": 100 },
    "actor": { "enum": ["model", "user"] },
    "status": { "const": "unknown" },
    "reported_status": { "enum": ["passed", "failed", "unknown"] },
    "ok": { "const": false },
    "reason": { "type": "string", "minLength": 1, "maxLength": 100 },
    "reprompt": { "type": "number", "minimum": 0 },
    "errors": { "type": "number", "minimum": 0 },
    "retries": { "type": "number", "minimum": 0 },
    "turns": { "type": "number", "minimum": 0 },
    "tokens_in": { "type": "number", "minimum": 0 },
    "tokens_out": { "type": "number", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "authority": { "enum": ["runtime_observation", "manual_observation"] },
    "trusted": { "const": false },
    "receipt_verified": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "route" } }, "required": ["type"] },
      "then": { "required": ["timestamp", "turn_id", "prompt_hash", "prompt_len", "terms", "holdout", "holdout_declared", "mode", "batuta_version", "ms", "duration_ms", "suggestions"] }
    },
    {
      "if": { "properties": { "type": { "const": "activation" } }, "required": ["type"] },
      "then": { "required": ["turn_id", "skill", "version", "actor", "authority", "trusted"] }
    },
    {
      "if": { "properties": { "type": { "const": "outcome" } }, "required": ["type"] },
      "then": { "required": ["turn_id", "status", "authority", "trusted", "receipt_verified"] }
    },
    {
      "if": { "properties": { "type": { "const": "route_error" } }, "required": ["type"] },
      "then": { "required": ["reason"] }
    }
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "skill": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+~-]{0,127}$" },
    "correlation": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+~-]{0,159}$" }
  }
}
